<Window x:Class="MinecraftProjectLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SAPVP-AI" Height="720" Width="1080" WindowState="Maximized"
        MinHeight="640" MinWidth="900" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}">
  <Window.Resources>
    <Style x:Key="SidebarNavigationButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Height" Value="42" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="NavigationSurface" Background="{TemplateBinding Background}" CornerRadius="9"/>
              <Border x:Name="SelectionMark" Width="3" Background="{TemplateBinding BorderBrush}" CornerRadius="2" HorizontalAlignment="Left" Margin="0,8,0,8"/>
              <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavigationSurface" Property="Opacity" Value="0.88"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="NavigationSurface" Property="Opacity" Value="0.75"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="NavigationSurface" Property="Opacity" Value="0.48"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SettingsCategoryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Padding" Value="12,9" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="CategorySurface" Background="{TemplateBinding Background}" CornerRadius="8"/>
              <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
              <Border x:Name="CategoryIndicator" Height="2" Background="{TemplateBinding BorderBrush}" CornerRadius="1" VerticalAlignment="Bottom" Margin="12,0,12,0"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CategorySurface" Property="Opacity" Value="0.88"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="CategorySurface" Property="Opacity" Value="0.75"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="CategorySurface" Property="Opacity" Value="0.48"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <DataTemplate x:Key="InstanceAssetItemTemplate">
      <Border Background="{DynamicResource ResultBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="10" Margin="0,0,0,7">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Description}" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0"/></StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Abrir" Tag="{Binding}" Click="OpenInstanceAsset_Click" Padding="9,5" FontSize="10" Background="{DynamicResource SecondaryButtonBrush}"/><Button Content="Remover" Tag="{Binding}" Click="RemoveInstanceAsset_Click" Padding="9,5" Margin="5,0,0,0" FontSize="10" Background="{DynamicResource SecondaryButtonBrush}"/></StackPanel>
        </Grid>
      </Border>
    </DataTemplate>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="230" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}" Padding="24">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Top">
          <TextBlock Text="SAPVP-AI" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource SidebarTextBrush}" />
          <TextBlock Text="MINECRAFT • TREINO" Foreground="{DynamicResource SidebarMutedBrush}" FontSize="10" Margin="0,4,0,32" />
          <Button x:Name="HomeNavButton" Padding="12" Style="{StaticResource SidebarNavigationButtonStyle}" Background="{DynamicResource SidebarActiveBrush}" Foreground="{DynamicResource SidebarTextBrush}" Click="HomeNav_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" Width="22" VerticalAlignment="Center"/><TextBlock Text="Início" VerticalAlignment="Center"/></StackPanel></Button>
          <Button x:Name="InstancesNavButton" Margin="0,8,0,0" Style="{StaticResource SidebarNavigationButtonStyle}" Background="Transparent" Foreground="{DynamicResource SidebarTextBrush}" Click="InstancesNav_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" Width="22" VerticalAlignment="Center"/><TextBlock Text="Instâncias" VerticalAlignment="Center"/></StackPanel></Button>
          <Button x:Name="ModsNavButton" Margin="0,4,0,0" Style="{StaticResource SidebarNavigationButtonStyle}" Background="Transparent" Foreground="{DynamicResource SidebarTextBrush}" Click="ModsNav_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" Width="22" VerticalAlignment="Center"/><TextBlock Text="Biblioteca" VerticalAlignment="Center"/></StackPanel></Button>
          <Button x:Name="ReportsNavButton" Margin="0,4,0,0" Style="{StaticResource SidebarNavigationButtonStyle}" Background="Transparent" Foreground="{DynamicResource SidebarTextBrush}" Click="ReportsNav_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D5;" FontFamily="Segoe MDL2 Assets" Width="22" VerticalAlignment="Center"/><TextBlock Text="Sessões e validador" VerticalAlignment="Center"/></StackPanel></Button>
          <Button x:Name="StatusNavButton" Margin="0,4,0,0" Style="{StaticResource SidebarNavigationButtonStyle}" Background="Transparent" Foreground="{DynamicResource SidebarTextBrush}" Click="StatusNav_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" Width="22" VerticalAlignment="Center"/><TextBlock Text="Status dos serviços" VerticalAlignment="Center"/></StackPanel></Button>
          <Button x:Name="NewsNavButton" Margin="0,4,0,0" Style="{StaticResource SidebarNavigationButtonStyle}" Background="Transparent" Foreground="{DynamicResource SidebarTextBrush}" Click="NewsNav_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE789;" FontFamily="Segoe MDL2 Assets" Width="22" VerticalAlignment="Center"/><TextBlock Text="Novidades" VerticalAlignment="Center"/></StackPanel></Button>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom">
          <Button x:Name="SettingsNavButton" Margin="0,0,0,14" Style="{StaticResource SidebarNavigationButtonStyle}" Background="Transparent" Foreground="{DynamicResource SidebarTextBrush}" Click="SettingsNav_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Width="22" VerticalAlignment="Center"/><TextBlock Text="Configurações" VerticalAlignment="Center"/></StackPanel></Button>
          <TextBlock Text="Login Microsoft solicitado ao jogar" TextWrapping="Wrap" Foreground="{DynamicResource SidebarMutedBrush}" FontSize="12" />
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Column="1" Margin="32,24,32,24">
      <Grid x:Name="HomePage">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
          <TextBlock Text="Seu Minecraft, do seu jeito" FontSize="30" FontWeight="SemiBold" Margin="0,0,90,0" />
          <TextBlock Text="Escolha uma das versões aprovadas e inicie sua sessão." Margin="0,8,0,0" Foreground="{DynamicResource MutedBrush}" FontSize="15" />
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,28,0,20">
          <Grid.ColumnDefinitions><ColumnDefinition Width="2.1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Margin="0,0,16,0" CornerRadius="14" Background="{DynamicResource PanelBrush}" Padding="30">
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="500">
            <TextBlock Text="VERSÕES DO PROJETO" Foreground="{StaticResource AccentBrush}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" />
            <TextBlock Text="Selecione sua versão" FontSize="25" FontWeight="SemiBold" TextAlignment="Center" Margin="0,12,0,8" />
            <TextBlock Text="Escolha uma versão permitida. Os arquivos só serão baixados quando você iniciar o jogo ou instalar mods." TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource MutedBrush}" FontSize="14" Margin="0,0,0,24" />
            <TextBlock Text="VERSÃO DO MINECRAFT JAVA" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8" />
            <ComboBox x:Name="VersionSelector" Height="44" FontSize="15" Padding="12,8" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" IsEditable="False" ToolTip="Escolha uma das versões liberadas pelo projeto" />
            <StackPanel x:Name="HomeRecentInstancePanel" Visibility="Collapsed" Margin="0,16,0,0">
              <TextBlock Text="INSTÂNCIA PARA JOGAR" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,7" />
              <ComboBox x:Name="HomeRecentInstanceSelector" Height="42" FontSize="14" Padding="12,7" VerticalContentAlignment="Center" SelectionChanged="HomeRecentInstanceSelector_SelectionChanged" ToolTip="Escolha qualquer instância criada para iniciar o Minecraft" />
            </StackPanel>
            <Button x:Name="LaunchButton" Content="Entrar com Microsoft e jogar" Margin="0,20,0,0" Padding="22,12" Background="{StaticResource AccentBrush}" Foreground="#101216" FontWeight="Bold" BorderThickness="0" HorizontalAlignment="Stretch" Click="LaunchMinecraft_Click" />
            <ProgressBar x:Name="LaunchProgress" Height="5" Margin="0,18,0,0" IsIndeterminate="True" Visibility="Collapsed" />
            <TextBlock x:Name="StatusText" Text="Pronto para jogar." TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource MutedBrush}" FontSize="13" Margin="0,10,0,0" />
            <Border Margin="0,28,0,0" Padding="18" CornerRadius="10" Background="{DynamicResource SubPanelBrush}">
              <StackPanel>
                <TextBlock Text="IA DE TREINO • ETAPA FUTURA" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold" />
                <TextBlock Text="O launcher poderá voltar à tela principal quando o jogo fechar e apresentar o questionário da rotina de treino." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="13" Margin="0,8,0,0" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>
          <StackPanel Grid.Column="1">
            <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,10">
              <StackPanel>
                <TextBlock Text="PERFIL MICROSOFT" Foreground="{DynamicResource AccentBrush}" FontSize="10" FontWeight="Bold"/>
                <TextBlock x:Name="HomeAccountStatus" Text="Nenhuma conta conectada" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,7,0,0"/>
                <TextBlock Text="Conta usada para iniciar o Minecraft Java" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,3,0,9"/>
                <ComboBox x:Name="HomeAccountSelector" Height="40" Padding="9,6" FontSize="13" SelectionChanged="HomeAccountSelector_SelectionChanged">
                  <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Username}" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
                <Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Button Content="＋  Adicionar conta" Click="ConnectAccount_Click" Padding="10,8" Background="{StaticResource AccentBrush}" Foreground="#101216" FontWeight="SemiBold" BorderThickness="0"/>
                  <Button Grid.Column="1" Content="Remover conta" Click="SignOut_Click" Padding="10,8" Margin="8,0,0,0" Background="{DynamicResource IconBrush}" Foreground="{DynamicResource TextBrush}" BorderThickness="0"/>
                </Grid>
              </StackPanel>
            </Border>
            <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,10">
              <StackPanel><TextBlock Text="VERSÃO SELECIONADA" Foreground="{DynamicResource AccentBrush}" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="HomeInstanceStatus" Text="Selecione uma versão" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,7,0,0"/><TextBlock x:Name="HomeProfileStatus" Text="Perfil: Padrão" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,4,0,0"/></StackPanel>
            </Border>
            <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,10">
              <StackPanel><TextBlock Text="MODS INSTALADOS" Foreground="{DynamicResource AccentBrush}" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="HomeContentStatus" Text="0 mods" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel>
            </Border>
            <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
              <StackPanel><TextBlock Text="NOVIDADES" Foreground="{DynamicResource AccentBrush}" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="HomeNewsStatus" Text="Feed sincronizado automaticamente" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel>
            </Border>
          </StackPanel>
        </Grid>
        <DockPanel Grid.Row="2">
          <TextBlock Text="Minecraft Java • Windows" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
          <TextBlock DockPanel.Dock="Right" Text="Somente versões permitidas" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
        </DockPanel>
      </Grid>

      <Grid x:Name="ModrinthPage" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,90,10"><TextBlock x:Name="LibraryTitle" Text="Biblioteca" FontSize="30" FontWeight="SemiBold"/><TextBlock x:Name="LibrarySubtitle" Text="Explore mods e resource packs do Modrinth e organize suas versões." Foreground="{DynamicResource MutedBrush}" FontSize="14" Margin="0,5,0,0"/></StackPanel>
        <TabControl x:Name="LibraryTabs" Grid.Row="1" Background="Transparent" BorderThickness="0" SelectionChanged="LibraryTabs_SelectionChanged">
          <TabItem x:Name="ExploreModsTab"><TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="⬡" FontFamily="Segoe UI Symbol" FontSize="16" Margin="0,0,8,0"/><TextBlock Text="Explorar mods"/></StackPanel></TabItem.Header>
            <Grid Margin="16,10,16,16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <Border Background="{DynamicResource SubPanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="12" Margin="0,0,0,10">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBox x:Name="ModSearchBox" Height="42" FontSize="16" Padding="14,8" VerticalContentAlignment="Center" ToolTip="Buscar mods no Modrinth" KeyDown="ModSearch_KeyDown"/>
                  <ComboBox x:Name="LibraryGameVersionBox" Grid.Column="1" Margin="10,0,0,0" Height="42" FontSize="14" Padding="12,7" VerticalContentAlignment="Center" SelectionChanged="LibraryVersion_Changed" ToolTip="Versão do Minecraft"/>
                  <Button x:Name="ModSearchButton" Grid.Column="2" Content="Buscar mods" Margin="10,0,0,0" Padding="19,8" FontSize="14" Background="{StaticResource AccentBrush}" Foreground="#101216" FontWeight="Bold" Click="ModSearch_Click"/>
                  <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,7,0,0">
                    <TextBlock Text="MOD LOADER" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,9,0" FontSize="11" FontWeight="SemiBold"/>
                    <Border Background="{DynamicResource SelectedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="13,6"><TextBlock Text="FABRIC" Foreground="{DynamicResource TextBrush}" FontSize="13" FontWeight="SemiBold"/></Border>
                    <TextBlock Text="Categoria" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="24,0,9,0" FontSize="13"/>
                    <ComboBox x:Name="ModCategoryBox" Width="170" Height="34" FontSize="13" VerticalContentAlignment="Center" SelectionChanged="ModCategory_Changed">
                      <ComboBoxItem Content="Todas" Tag="" IsSelected="True"/><ComboBoxItem Content="Desempenho" Tag="optimization"/><ComboBoxItem Content="Tecnologia" Tag="technology"/><ComboBoxItem Content="Utilidade" Tag="utility"/><ComboBoxItem Content="Aventura" Tag="adventure"/><ComboBoxItem Content="Decoração" Tag="decoration"/><ComboBoxItem Content="Mecânicas" Tag="game-mechanics"/><ComboBoxItem Content="Bibliotecas" Tag="library"/><ComboBoxItem Content="Magia" Tag="magic"/><ComboBoxItem Content="Criaturas" Tag="mobs"/><ComboBoxItem Content="Armazenamento" Tag="storage"/><ComboBoxItem Content="Transporte" Tag="transportation"/><ComboBoxItem Content="Geração de mundo" Tag="worldgen"/>
                    </ComboBox>
                    <TextBlock Text="Ordenar por" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="20,0,9,0" FontSize="13"/>
                    <ComboBox x:Name="ModSortBox" Width="185" Height="34" FontSize="13" VerticalContentAlignment="Center" SelectionChanged="ModSort_Changed"/>
                  </StackPanel>
                  <ComboBox x:Name="ModLoaderBox" Visibility="Collapsed"/>
                </Grid>
              </Border>
              <Border Grid.Row="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="16">
                <DockPanel>
                  <Grid DockPanel.Dock="Top" Margin="2,0,2,12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Resultados" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock x:Name="ModResultsLabel" Grid.Column="1" Text="Carregando mods populares..." Foreground="{DynamicResource MutedBrush}" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Right"/></Grid>
                  <DockPanel DockPanel.Dock="Bottom" LastChildFill="False" Margin="0,10,0,0"><Button x:Name="PreviousModPageButton" Content="← Anterior" Click="PreviousModPage_Click" Padding="14,8" FontSize="13" Background="{DynamicResource SecondaryButtonBrush}" IsEnabled="False"/><TextBlock x:Name="ModPageLabel" Text="Página 1" Foreground="{DynamicResource MutedBrush}" FontSize="13" VerticalAlignment="Center" Margin="12,0"/><Button x:Name="NextModPageButton" DockPanel.Dock="Right" Content="Próxima →" Click="NextModPage_Click" Padding="14,8" FontSize="13" Background="{DynamicResource SecondaryButtonBrush}" IsEnabled="False"/>
                  </DockPanel>
                  <ListBox x:Name="ModResultsList" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate><DataTemplate><Border Background="{DynamicResource ResultBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,9" HorizontalAlignment="Stretch" Cursor="Hand" ToolTip="Clique para ver detalhes e versões compatíveis" MouseLeftButtonUp="ModResultCard_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="46" Height="46" CornerRadius="11" Background="{DynamicResource IconBrush}"><Image Source="{Binding IconUrl}" Stretch="UniformToFill"/></Border><StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center"><TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" TextWrapping="Wrap" MaxHeight="38" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,3,0,0"/><TextBlock Text="{Binding Detail}" Foreground="{StaticResource AccentBrush}" FontSize="11" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="2" VerticalAlignment="Center"><Button Content="Detalhes" Tag="{Binding}" Click="OpenModDetails_Click" Padding="15,8" FontSize="12" Background="{DynamicResource SecondaryButtonBrush}"/><Button Content="Instalar" Tag="{Binding}" Click="InstallMod_Click" Padding="18,10" FontSize="13" Margin="0,6,0,0" Background="{StaticResource AccentBrush}" Foreground="#101216" FontWeight="SemiBold"/></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate>
                  </ListBox>
                </DockPanel>
              </Border>
            </Grid>
          </TabItem>
          <TabItem x:Name="ResourcePacksTab"><TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B9;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0"/><TextBlock Text="Resource packs"/></StackPanel></TabItem.Header>
            <Grid Margin="16,10,16,16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <Border Background="{DynamicResource SubPanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="12" Margin="0,0,0,10"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="ResourcePackSearchBox" Height="42" FontSize="16" Padding="14,8" VerticalContentAlignment="Center" ToolTip="Buscar resource packs no Modrinth" KeyDown="ResourcePackSearch_KeyDown"/><ComboBox x:Name="ResourcePackGameVersionBox" Grid.Column="1" Margin="10,0,0,0" Height="42" FontSize="14" Padding="12,7" VerticalContentAlignment="Center" SelectionChanged="ResourcePackVersion_Changed" ToolTip="Versão do Minecraft"/><Button x:Name="ResourcePackSearchButton" Grid.Column="2" Content="Buscar packs" Margin="10,0,0,0" Padding="19,8" FontSize="14" Background="{StaticResource AccentBrush}" Foreground="#101216" FontWeight="Bold" Click="ResourcePackSearch_Click"/>
                <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,7,0,0"><TextBlock Text="Categoria" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,9,0" FontSize="13"/><ComboBox x:Name="ResourcePackCategoryBox" Width="180" Height="34" FontSize="13" VerticalContentAlignment="Center" SelectionChanged="ResourcePackCategory_Changed"><ComboBoxItem Content="Todas" Tag="" IsSelected="True"/><ComboBoxItem Content="Resolução" Tag="resolution"/><ComboBoxItem Content="Realista" Tag="realistic"/><ComboBoxItem Content="Shaders" Tag="shaders"/><ComboBoxItem Content="Modelos" Tag="models"/><ComboBoxItem Content="Temática" Tag="themed"/><ComboBoxItem Content="Simplista" Tag="simplistic"/></ComboBox><TextBlock Text="Ordenar por" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="20,0,9,0" FontSize="13"/><ComboBox x:Name="ResourcePackSortBox" Width="185" Height="34" FontSize="13" VerticalContentAlignment="Center" SelectionChanged="ResourcePackSort_Changed"/></StackPanel>
              </Grid></Border>
              <Border Grid.Row="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="16"><DockPanel>
                <Grid DockPanel.Dock="Top" Margin="2,0,2,12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Resultados" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock x:Name="ResourcePackResultsLabel" Grid.Column="1" Text="Busque resource packs no Modrinth" Foreground="{DynamicResource MutedBrush}" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Right"/></Grid>
                <DockPanel DockPanel.Dock="Bottom" LastChildFill="False" Margin="0,10,0,0"><Button x:Name="PreviousResourcePackPageButton" Content="← Anterior" Click="PreviousResourcePackPage_Click" Padding="14,8" FontSize="13" Background="{DynamicResource SecondaryButtonBrush}" IsEnabled="False"/><TextBlock x:Name="ResourcePackPageLabel" Text="Página 1" Foreground="{DynamicResource MutedBrush}" FontSize="13" VerticalAlignment="Center" Margin="12,0"/><Button x:Name="NextResourcePackPageButton" DockPanel.Dock="Right" Content="Próxima →" Click="NextResourcePackPage_Click" Padding="14,8" FontSize="13" Background="{DynamicResource SecondaryButtonBrush}" IsEnabled="False"/></DockPanel>
                <ListBox x:Name="ResourcePackResultsList" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><Border Background="{DynamicResource ResultBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="46" Height="46" CornerRadius="11" Background="{DynamicResource IconBrush}"><Image Source="{Binding IconUrl}" Stretch="UniformToFill"/></Border><StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center"><TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" TextWrapping="Wrap" MaxHeight="38" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,3,0,0"/><TextBlock Text="{Binding Detail}" Foreground="{StaticResource AccentBrush}" FontSize="11" Margin="0,4,0,0"/></StackPanel><Button Grid.Column="2" Content="Instalar" Tag="{Binding}" Click="InstallResourcePack_Click" Padding="18,10" FontSize="13" Background="{StaticResource AccentBrush}" Foreground="#101216" FontWeight="SemiBold" VerticalAlignment="Center"/></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
              </DockPanel></Border>
            </Grid>
          </TabItem>
          <TabItem x:Name="ShadersTab"><TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE706;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0"/><TextBlock Text="Shaders"/></StackPanel></TabItem.Header>
            <Grid Margin="16,10,16,16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
