          <ListBox.Resources>
            <Style TargetType="ListBoxItem">
              <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,12"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
              <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border Background="Transparent" Padding="0"><ContentPresenter HorizontalAlignment="Stretch"/></Border></ControlTemplate></Setter.Value></Setter>
            </Style>
          </ListBox.Resources>
          <ListBox.ItemTemplate><DataTemplate>
            <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" HorizontalAlignment="Stretch">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{StaticResource AccentBrush}" CornerRadius="2"/>
                <Grid Grid.Column="1" Margin="16,0,0,0">
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    <Border Background="{DynamicResource SidebarActiveBrush}" CornerRadius="5" Padding="7,3" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="{Binding BadgeVisibility}"><TextBlock Text="NOVA" Foreground="{DynamicResource AccentBrush}" FontSize="9" FontWeight="Bold"/></Border>
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="{Binding PublishedAtLabel}" Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center"/>
                  <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Message}" Visibility="{Binding MessageVisibility}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="13" LineHeight="20" Margin="0,10,0,0"/>
                  <DockPanel Grid.Row="2" Grid.ColumnSpan="2" LastChildFill="False" Margin="0,15,0,0">
                    <TextBlock Text="{Binding ReadStateLabel}" Foreground="{DynamicResource MutedBrush}" FontSize="11" VerticalAlignment="Center"/>
                    <Button DockPanel.Dock="Right" Content="{Binding ReadLabel}" Click="MarkNewsRead_Click" MinWidth="150" Padding="13,8" Background="{DynamicResource SecondaryButtonBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" FontWeight="SemiBold" Cursor="Hand"/>
                  </DockPanel>
                </Grid>
              </Grid>
            </Border>
          </DataTemplate></ListBox.ItemTemplate>
        </ListBox>
          <Border x:Name="NewsEmptyPanel" Visibility="Collapsed" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="28" VerticalAlignment="Center" Margin="0,8,0,18">
            <StackPanel HorizontalAlignment="Center" MaxWidth="480">
              <Border Width="52" Height="52" CornerRadius="16" Background="{DynamicResource SidebarActiveBrush}" HorizontalAlignment="Center"><TextBlock Text="✦" Foreground="{DynamicResource AccentBrush}" FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
              <TextBlock x:Name="NewsEmptyTitle" Text="Tudo em dia" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,0"/>
              <TextBlock x:Name="NewsEmptyDescription" Text="Quando houver novidades do projeto, elas aparecerão aqui." Foreground="{DynamicResource MutedBrush}" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>
          </Border>
        </Grid>
        <TextBlock Grid.Row="3" Text="Atualização automática · histórico de 7 dias · avisos lidos ficam disponíveis por 4 horas" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,10,0,0"/>
      </Grid>

      <Grid x:Name="SettingsPage" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel>
          <TextBlock Text="Configurações" FontSize="30" FontWeight="SemiBold"/>
          <TextBlock Text="Ajuste o launcher e o Minecraft por categoria." Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,14"/>
          <WrapPanel Margin="0,0,0,18">
            <Button x:Name="SettingsAppearanceTab" Tag="appearance" Click="SettingsCategory_Click" Margin="0,0,7,0" Style="{StaticResource SettingsCategoryButtonStyle}" Background="{DynamicResource SidebarActiveBrush}" Foreground="{DynamicResource TextBrush}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0"/><TextBlock Text="Aparência"/></StackPanel></Button>
            <Button x:Name="SettingsJavaTab" Tag="java" Click="SettingsCategory_Click" Margin="0,0,7,0" Style="{StaticResource SettingsCategoryButtonStyle}" Background="Transparent" Foreground="{DynamicResource TextBrush}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE756;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0"/><TextBlock Text="Java"/></StackPanel></Button>
            <Button x:Name="SettingsPerformanceTab" Tag="performance" Click="SettingsCategory_Click" Margin="0,0,7,0" Style="{StaticResource SettingsCategoryButtonStyle}" Background="Transparent" Foreground="{DynamicResource TextBrush}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0"/><TextBlock Text="Desempenho"/></StackPanel></Button>
            <Button x:Name="SettingsAccountTab" Tag="account" Click="SettingsCategory_Click" Margin="0,0,7,0" Style="{StaticResource SettingsCategoryButtonStyle}" Background="Transparent" Foreground="{DynamicResource TextBrush}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0"/><TextBlock Text="Conta e aparência"/></StackPanel></Button>
            <Button x:Name="SettingsMoreTab" Tag="more" Click="SettingsCategory_Click" Style="{StaticResource SettingsCategoryButtonStyle}" Background="Transparent" Foreground="{DynamicResource TextBrush}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0"/><TextBlock Text="Discord e atualizações"/></StackPanel></Button>
          </WrapPanel>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel>
          <TextBlock x:Name="SettingsCategoryTitle" Text="Aparência" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,4"/>
          <TextBlock x:Name="SettingsCategoryDescription" Text="Escolha o visual do SAPVP-AI." Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,14"/>
          <Border x:Name="AppearanceSettingsCard" Background="{DynamicResource PanelBrush}" CornerRadius="12" Padding="20" Margin="0,0,0,14"><StackPanel><TextBlock Text="Aparência" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Escolha um tema vendo uma prévia antes de aplicar." Foreground="{DynamicResource MutedBrush}" Margin="0,7,0,12"/><UniformGrid Columns="2"><Button x:Name="DarkThemeOption" Tag="dark" Click="ThemeOption_Click" Padding="12" Margin="0,0,8,0" Background="{DynamicResource SecondaryButtonBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"><StackPanel><Border Background="#100D0F" BorderBrush="#392B30" BorderThickness="1" CornerRadius="8" Height="76" Padding="9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#21181B" CornerRadius="4" Margin="0,0,6,0"/><StackPanel Grid.Column="1"><Border Background="#302328" Height="10" CornerRadius="4" Margin="0,2,25,5"/><Border Background="#5B1B2B" Height="12" CornerRadius="4" Margin="0,0,8,0"/></StackPanel></Grid></Border><TextBlock Text="Escuro" FontWeight="SemiBold" HorizontalAlignment="Left" Margin="0,9,0,0"/><TextBlock Text="Interface escura com detalhes vermelhos." FontSize="11" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Left" Margin="0,3,0,0"/></StackPanel></Button><Button x:Name="LightThemeOption" Tag="light" Click="ThemeOption_Click" Padding="12" Margin="8,0,0,0" Background="{DynamicResource SecondaryButtonBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"><StackPanel><Border Background="#F6F6F8" BorderBrush="#D7CFD3" BorderThickness="1" CornerRadius="8" Height="76" Padding="9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#E8E3E6" CornerRadius="4" Margin="0,0,6,0"/><StackPanel Grid.Column="1"><Border Background="#E5DDE0" Height="10" CornerRadius="4" Margin="0,2,25,5"/><Border Background="#E31837" Height="12" CornerRadius="4" Margin="0,0,8,0"/></StackPanel></Grid></Border><TextBlock Text="Claro" FontWeight="SemiBold" HorizontalAlignment="Left" Margin="0,9,0,0"/><TextBlock Text="Interface clara com acentos vermelhos." FontSize="11" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Left" Margin="0,3,0,0"/></StackPanel></Button></UniformGrid><TextBlock x:Name="ThemePreviewStatus" Text="Prévia do tema atual." Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,10,0,0"/></StackPanel></Border>
          <Border x:Name="JavaSettingsCard" Visibility="Collapsed" Background="{DynamicResource PanelBrush}" CornerRadius="12" Padding="20" Margin="0,0,0,14"><StackPanel><TextBlock Text="Java" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Escolha uma instalação Java encontrada no computador ou indique outra pasta." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,10"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="JavaRuntimeBox" Height="38" VerticalContentAlignment="Center" SelectionChanged="JavaRuntime_SelectionChanged"/><Button Grid.Column="1" Content="Procurar Java…" Click="BrowseJava_Click" Padding="13,8" Margin="8,0,0,0" Background="{DynamicResource SecondaryButtonBrush}" Foreground="{DynamicResource TextBrush}"/><Button Grid.Column="2" Content="Automático" Click="ResetJava_Click" Padding="13,8" Margin="8,0,0,0" Background="{DynamicResource SecondaryButtonBrush}" Foreground="{DynamicResource TextBrush}"/></Grid><TextBox x:Name="JavaPathBox" Height="36" VerticalContentAlignment="Center" Margin="0,9,0,0" ToolTip="Caminho do java.exe ou javaw.exe" LostFocus="JavaPath_LostFocus"/><TextBlock x:Name="JavaPathStatus" Text="Java automático" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0"/><TextBlock Text="Minecraft 1.21.x requer Java 21. Minecraft 26.1+ requer Java 25. Java 8 e 17 podem ser selecionados se estiverem instalados, mas não são compatíveis com estas versões." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,7,0,0"/></StackPanel></Border>
          <Border x:Name="PerformanceSettingsCard" Visibility="Collapsed" Background="{DynamicResource PanelBrush}" CornerRadius="12" Padding="20" Margin="0,0,0,14"><StackPanel><DockPanel><TextBlock Text="Desempenho do Minecraft" FontSize="19" FontWeight="SemiBold"/><Button DockPanel.Dock="Right" Content="Sugerir RAM" Click="SuggestMemory_Click" Padding="11,6" Background="{DynamicResource SecondaryButtonBrush}" Foreground="{DynamicResource TextBrush}" BorderThickness="0"/></DockPanel><TextBlock Text="Memória máxima para o Minecraft" Foreground="{DynamicResource MutedBrush}" Margin="0,16,0,2"/><Grid Margin="0,2,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="84"/></Grid.ColumnDefinitions><Slider x:Name="MemorySlider" Grid.Column="0" Minimum="2048" Maximum="16384" TickFrequency="512" SmallChange="512" LargeChange="1024" IsSnapToTickEnabled="False" HorizontalAlignment="Stretch" VerticalAlignment="Center" MinWidth="240" Height="32" ToolTip="Arraste para escolher a memória" ValueChanged="MemorySlider_Changed"/><TextBlock x:Name="MemoryValueLabel" Grid.Column="1" Text="4 GB" TextAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="15"/></Grid><DockPanel Margin="0,0,0,6"><TextBlock Text="2 GB" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="16 GB" Foreground="{DynamicResource MutedBrush}" DockPanel.Dock="Right"/></DockPanel><TextBlock Text="Ajuste a barra de acordo com a memória do computador. O launcher reserva memória para o Windows e outros programas." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,5,0,0"/><CheckBox x:Name="FullScreenBox" Content="Iniciar em tela cheia" Checked="Fullscreen_Changed" Unchecked="Fullscreen_Changed" Margin="0,14,0,0"/><TextBlock Text="Argumentos Java adicionais (avançado)" Foreground="{DynamicResource MutedBrush}" Margin="0,14,0,6"/><TextBox x:Name="ExtraJvmArgumentsBox" MinHeight="58" TextWrapping="Wrap" AcceptsReturn="True" LostFocus="ExtraJvmArguments_LostFocus" ToolTip="Ex.: -XX:+UseG1GC"/><TextBlock Text="Argumentos incorretos podem impedir o jogo de iniciar." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0"/></StackPanel></Border>
          <Border x:Name="PresenceSettingsCard" Visibility="Collapsed" Background="{DynamicResource PanelBrush}" CornerRadius="12" Padding="20" Margin="0,0,0,14"><StackPanel><TextBlock Text="Rich Presence do Discord" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Ative ou oculte a atividade no seu próprio perfil. O jogo tem prioridade enquanto estiver aberto; a localização do launcher aparece somente em Início, Biblioteca de mods e Instâncias." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,10"/><CheckBox x:Name="LauncherPresenceBox" Content="Mostrar a atividade do SAPVP-AI" Checked="DiscordPresence_Changed" Unchecked="DiscordPresence_Changed" Margin="0,4,0,0"/><CheckBox x:Name="MinecraftPresenceBox" Content="Mostrar a atividade do Minecraft iniciado pelo launcher" Checked="DiscordPresence_Changed" Unchecked="DiscordPresence_Changed" Margin="0,6,0,0"/><TextBlock x:Name="DiscordPresenceStatus" Text="Rich Presence desativado." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,9,0,0"/></StackPanel></Border>
          <Border x:Name="AccountSettingsCard" Visibility="Collapsed" Background="{DynamicResource PanelBrush}" CornerRadius="12" Padding="20" Margin="0,0,0,14"><StackPanel><TextBlock Text="Contas Microsoft" FontSize="19" FontWeight="SemiBold"/><TextBlock x:Name="AccountStatus" Text="Nenhuma conta conectada" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,12"/><WrapPanel><Button Content="Adicionar conta original" Click="ConnectAccount_Click" Padding="14,9" Background="{StaticResource AccentBrush}" Foreground="#101216" FontWeight="Bold" BorderThickness="0"/><Button Content="Remover selecionada" Click="SignOut_Click" Padding="14,9" Margin="8,0,0,0" Background="{DynamicResource IconBrush}" Foreground="{DynamicResource TextBrush}" BorderThickness="0"/></WrapPanel><TextBlock Text="Escolha a conta na tela inicial. Instâncias, mods e configurações são compartilhados e permanecem no computador." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel></Border>
          <Border x:Name="SkinSettingsCard" Visibility="Collapsed" Background="{DynamicResource PanelBrush}" CornerRadius="12" Padding="20" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Text="Skin e capa" FontSize="19" FontWeight="SemiBold"/>
              <TextBlock Text="Veja a aparência ativa da conta selecionada e personalize seu personagem." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,14"/>
              <Grid Margin="0,0,0,15"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Background="{DynamicResource SubPanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,6,0">
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="76" Height="94" Background="{DynamicResource ControlBrush}" CornerRadius="8" Padding="5" HorizontalAlignment="Left"><Image x:Name="SkinPreviewImage" Stretch="Uniform"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0"><TextBlock Text="SKIN ATIVA" Foreground="{DynamicResource AccentBrush}" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="SkinPreviewLabel" Text="Atualize para ver sua skin" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock Text="Textura do perfil Minecraft" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,3,0,0"/></StackPanel></Grid>
                </Border>
                <Border Grid.Column="1" Background="{DynamicResource SubPanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="6,0,0,0">
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="76" Height="94" Background="{DynamicResource ControlBrush}" CornerRadius="8" Padding="5" HorizontalAlignment="Left"><Image x:Name="CapePreviewImage" Stretch="Uniform"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0"><TextBlock Text="CAPA ATIVA" Foreground="{DynamicResource AccentBrush}" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="CapePreviewLabel" Text="Atualize para ver sua capa" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock Text="Apenas capas desta conta" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,3,0,0"/></StackPanel></Grid>
                </Border>
              </Grid>
              <WrapPanel VerticalAlignment="Center"><Button Content="Escolher skin PNG" Click="ChooseSkin_Click" Padding="14,9" Background="{DynamicResource SecondaryButtonBrush}" Foreground="{DynamicResource TextBrush}" BorderThickness="0"/><ComboBox x:Name="SkinModelBox" Width="145" Height="38" Margin="8,0,0,0" Padding="8,5" SelectedIndex="0"><ComboBoxItem Content="Modelo clássico" Tag="classic"/><ComboBoxItem Content="Modelo slim" Tag="slim"/></ComboBox><Button Content="Enviar skin" Click="UploadSkin_Click" Padding="14,9" Margin="8,0,0,0" Background="{StaticResource AccentBrush}" Foreground="#101216" FontWeight="SemiBold" BorderThickness="0"/></WrapPanel>
              <WrapPanel Margin="0,12,0,0" VerticalAlignment="Center"><ComboBox x:Name="OwnedCapeBox" Width="245" Height="38" Padding="8,5"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><Button Content="Atualizar aparência" Click="RefreshCapes_Click" Padding="12,8" Margin="8,0,0,0" Background="{DynamicResource SecondaryButtonBrush}" Foreground="{DynamicResource TextBrush}" BorderThickness="0"/><Button Content="Equipar" Click="EquipCape_Click" Padding="12,8" Margin="8,0,0,0" Background="{DynamicResource SecondaryButtonBrush}" Foreground="{DynamicResource TextBrush}" BorderThickness="0"/><Button Content="Ocultar" Click="HideCape_Click" Padding="12,8" Margin="8,0,0,0" Background="{DynamicResource IconBrush}" Foreground="{DynamicResource TextBrush}" BorderThickness="0"/></WrapPanel>
              <TextBlock x:Name="SkinStatus" Text="Selecione uma conta e atualize a aparência." Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
          <Border x:Name="NewsSettingsCard" Visibility="Collapsed" Background="{DynamicResource PanelBrush}" CornerRadius="12" Padding="20" Margin="0,0,0,14"><StackPanel><TextBlock Text="Novidades do projeto" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="O feed é gerenciado pelo projeto e atualizado automaticamente. Jogadores não podem trocar o endereço pelo launcher. Para distribuir a todos, o projeto precisa configurar uma URL HTTPS estável; o bot e o token permanecem somente com a administração." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border>
          <Border x:Name="UpdatesSettingsCard" Visibility="Collapsed" Background="{DynamicResource PanelBrush}" CornerRadius="12" Padding="20"><StackPanel><TextBlock Text="Atualizações do launcher" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Consulte uma versão publicada no GitHub. O instalador será verificado por SHA-256 antes de abrir." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,12"/><WrapPanel><Button x:Name="UpdateLauncherButton" Content="Verificar atualizações" Click="CheckLauncherUpdates_Click" Padding="14,9" Background="{DynamicResource SecondaryButtonBrush}" Foreground="{DynamicResource TextBrush}" BorderThickness="0"/><TextBlock x:Name="LauncherUpdateStatus" Text="Versão atual: 1.0.0" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/></WrapPanel></StackPanel></Border>
        </StackPanel></ScrollViewer>
      </Grid>
    </Grid>
  </Grid>
</Window>






